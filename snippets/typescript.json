{
  "await sleep": {
    "prefix": "ast",
    "body": "await new Promise((r) => setTimeout(r, ${0}))"
  },
  "describe top level": {
    "prefix": "dt",
    "body": "describe('${TM_FILENAME_BASE}', () => {\n\t${0}\n})"
  },
  "let statement": {
    "prefix": "l",
    "body": "let ${1:name}"
  },
  "const statement": {
    "prefix": "c",
    "body": "const ${1:name}"
  },
  "const statement from destructuring": {
    "prefix": "cd",
    "body": "const { ${2:prop} } = ${1:value}"
  },
  "const statement from array destructuring": {
    "prefix": "cad",
    "body": "const [ ${2:prop} ] = ${1:value}"
  },
  "const assignment awaited": {
    "prefix": "ca",
    "body": "const ${1:name} = await ${2:value}"
  },
  "it asynchronous": {
    "prefix": "it",
    "body": "it('${1:description}', async () => {\n\t${0}\n})"
  },
  "console.log": {
    "prefix": "cl",
    "body": "console.log('yolo', ${0})"
  },
  "console.log with log": {
    "prefix": "log",
    "body": "console.log('yolo', ${0})"
  },
  "console.log a variable": {
    "prefix": "cv",
    "body": "console.log('yolo ${1}:', ${1})"
  },
  "console.error": {
    "prefix": "ce",
    "body": "console.error('yolo', ${0})"
  },
  "console.warn": {
    "prefix": "cw",
    "body": "console.warn('yolo',${0})"
  },
  "console.dir": {
    "prefix": "cod",
    "body": "console.dir('${1}:', ${1})"
  },
  "arrow function": {
    "prefix": "af",
    "body": ["const ${1:name} = (${2}) => {", "\t$0", "}"],
    "description": "Arrow function"
  },
  "try/catch": {
    "prefix": "tc",
    "body": "try {\n\t${0}\n} catch (${1:err}) {\n\t\n}"
  },
  "regular function": {
    "prefix": "fn",
    "body": ["function ${1:name}(${2}) {", "\t$0", "}"],
    "description": "Function declaration"
  },
  "if statement": {
    "prefix": "ifs",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "If statement"
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:array}.length; ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "For loop"
  }
}
